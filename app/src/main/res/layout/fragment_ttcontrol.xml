<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="viewModel"
            type="eu.agribot.agribotapp.ui.fragment.ttcontrol.TTControlViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:baselineAligned="false">


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/margin_large"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                android:gravity="center"
                android:text="LEWO / PRAWO"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_large"
                android:textStyle="bold" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <io.github.controlwear.virtual.joystick.android.JoystickView
                android:id="@+id/horizontal_joystick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:JV_backgroundColor="@android:color/holo_green_light"
                app:JV_borderColor="@android:color/black"
                app:JV_borderWidth="2dp"
                app:JV_buttonColor="@android:color/black"
                app:JV_buttonSizeRatio="15%"
                app:JV_fixedCenter="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1" />


        </LinearLayout>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/margin_large"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/front_kart"
                android:layout_width="match_parent"
                android:layout_margin="@dimen/margin_xlarge"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:onClick="@{() -> viewModel.onFrontKartClicked()}"
                android:src="@drawable/f_grey" />

            <ImageView
                android:id="@+id/rear_kart"
                android:layout_width="match_parent"
                android:layout_margin="@dimen/margin_xlarge"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:onClick="@{() -> viewModel.onRearKartClicked()}"
                android:src="@drawable/r_grey" />


        </LinearLayout>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/margin_large"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                android:gravity="center"
                android:text="PRZÓD / TYŁ"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_large"
                android:textStyle="bold" />


            <View
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1" />


            <io.github.controlwear.virtual.joystick.android.JoystickView
                android:id="@+id/vertical_joystick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                app:JV_backgroundColor="@android:color/holo_green_light"
                app:JV_borderColor="@android:color/black"
                app:JV_borderWidth="2dp"
                app:JV_buttonColor="@android:color/black"
                app:JV_buttonSizeRatio="15%"
                app:JV_fixedCenter="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1" />


        </LinearLayout>

    </LinearLayout>

</layout>