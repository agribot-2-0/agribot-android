<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="eu.agribot.agribotapp.ui.fragment.authentication.signup.SignupViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toTopOf="@+id/email_edittext_register"
        app:layout_constraintTop_toTopOf="@+id/email_edittext_register">

        <EditText
            android:id="@+id/email_edittext_register"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/rounded_edittext_register_login"
            android:ems="10"
            android:hint="@string/email"
            android:inputType="textEmailAddress"
            android:onTextChanged="@{(text, start, before, count) -> viewModel.onEmailChanged(text)}"
            android:paddingStart="@dimen/margin_large"
            app:layout_constraintBottom_toTopOf="@+id/password_edittext_register"
            app:layout_constraintStart_toStartOf="@+id/password_edittext_register"
            tools:ignore="RtlSymmetry" />

        <EditText
            android:id="@+id/password_edittext_register"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="31dp"
            android:background="@drawable/rounded_edittext_register_login"
            android:ems="10"
            android:hint="@string/password"
            android:inputType="textPassword"
            android:onTextChanged="@{(text, start, before, count) -> viewModel.onPasswordChanged(text)}"
            android:paddingStart="@dimen/margin_large"
            app:layout_constraintBottom_toTopOf="@+id/register_button_register"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="RtlSymmetry" />

        <Button
            android:id="@+id/register_button_register"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="54dp"
            android:layout_marginBottom="53dp"
            android:background="@drawable/rounded_button"
            android:onClick="@{() -> viewModel.onClickButtonRegister()}"
            android:text="@string/register"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/IhaveAccountButton"
            app:layout_constraintStart_toStartOf="@+id/password_edittext_register" />

        <TextView
            android:id="@+id/IhaveAccountButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="1dp"
            android:layout_marginBottom="218dp"
            android:onClick="@{() -> viewModel.onHaveAccountClicked()}"
            android:text="@string/i_have_account"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/register_button_register" />

        <ImageView
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="36dp"
            android:layout_marginBottom="52dp"
            android:background="@drawable/rounded_select_photo_button"
            android:src="@drawable/agribot_logo"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/email_edittext_register"
            app:layout_constraintEnd_toEndOf="@+id/email_edittext_register" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>