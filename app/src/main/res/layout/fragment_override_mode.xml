<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="eu.agribot.agribotapp.ui.fragment.override.OverrideViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black">


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/margin_large"
            android:layout_weight="1">

            <io.github.controlwear.virtual.joystick.android.JoystickView
                android:id="@+id/override_rotate_joystick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                app:JV_backgroundColor="@android:color/holo_green_light"
                app:JV_borderColor="@android:color/black"
                app:JV_borderWidth="2dp"
                app:JV_buttonColor="@android:color/black"
                app:JV_buttonSizeRatio="15%"
                app:JV_fixedCenter="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


        </LinearLayout>





        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/margin_large"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/front"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:onClick="@{() -> viewModel.onFrontClick()}"
                android:src="@drawable/f_grey" />

            <ImageView
                android:id="@+id/rear"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:onClick="@{() -> viewModel.onRearClick()}"
                android:src="@drawable/r_grey" />


        </LinearLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/margin_large"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="44dp"
                android:text="+"
                android:textColor="@color/white"
                android:textSize="32sp"
                app:layout_constraintBottom_toTopOf="@+id/manual_control_joystick"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />


            <io.github.controlwear.virtual.joystick.android.JoystickView
                android:id="@+id/override_gas_joystick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                app:JV_backgroundColor="@android:color/holo_green_light"
                app:JV_borderColor="@android:color/black"
                app:JV_borderWidth="2dp"
                app:JV_buttonColor="@android:color/black"
                app:JV_buttonSizeRatio="15%"
                app:JV_fixedCenter="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />



            <TextView
                android:id="@+id/textView6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="61dp"
                android:text="-"
                android:textColor="@color/white"
                android:textSize="32sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/manual_control_joystick" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</layout>