<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ToolbarTheme" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/white</item>
        <item name="android:background">@color/colorPrimary</item>
    </style>

    <style name="AgribotSwitch">
        <item name="android:track">@drawable/selector_switch_track</item>
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="android:switchMinWidth">64dp</item>
    </style>

    <style name="BottomInfoText" parent="@android:style/TextAppearance.Widget.TextView">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20dp</item>
    </style>

    <style name="MiddleInfoText" parent="@android:style/TextAppearance.Widget.TextView">
        <item name="android:textSize">20dp</item>
    </style>

    <style name="GroupInfoText" parent="@android:style/TextAppearance.Widget.TextView">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">25dp</item>
    </style>

</resources>
