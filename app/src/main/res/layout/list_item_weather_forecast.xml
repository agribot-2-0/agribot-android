<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tool="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="eu.agribot.agribotapp.ui.fragment.weather.forecast.ForecastWeatherViewModel" />
    </data>


    <androidx.cardview.widget.CardView
        android:layout_width="120dp"
        android:layout_height="180dp"
        android:layout_margin="@dimen/margin_medium"
        android:padding="@dimen/margin_small"
        android:orientation="vertical"
        app:cardCornerRadius="22dp"
        app:cardElevation="@dimen/margin_small">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/forecastDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@{viewModel.date}"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/forecastImage"
                android:layout_width="72dp"
                android:layout_height="64dp"
                tool:src="@drawable/ic_cloudy_weather" />

            <TextView
                android:id="@+id/forecastTemperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@{viewModel.temperature}"
                android:textSize="@dimen/text_size_large"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/forecastHumidity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{viewModel.humidity}"
                android:textSize="@dimen/text_size_small"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/forecastWind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{viewModel.wind}"
                android:textSize="@dimen/text_size_small"
                android:textStyle="bold" />


        </LinearLayout>

    </androidx.cardview.widget.CardView>
</layout>