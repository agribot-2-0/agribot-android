<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="eu.agribot.agribotapp.ui.fragment.toolcontrol.ToolControlViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/margin_large" />

                <com.warkiz.tickseekbar.TickSeekBar
                    android:id="@+id/listener1"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_margin="@dimen/margin_medium"
                    android:layout_weight="1"
                    app:tsb_max="99"
                    app:tsb_min="1"
                    app:tsb_progress="50"
                    app:tsb_show_tick_marks_type="oval"
                    app:tsb_show_tick_texts="above"
                    app:tsb_thumb_color="@color/colorAccent"
                    app:tsb_thumb_size="16dp"
                    app:tsb_tick_marks_color="@color/colorAccent"
                    app:tsb_tick_marks_size="8dp"
                    app:tsb_tick_texts_color="@android:color/darker_gray"
                    app:tsb_tick_texts_size="13sp"
                    app:tsb_ticks_count="11"
                    app:tsb_track_background_color="@android:color/darker_gray"
                    app:tsb_track_background_size="2dp"
                    app:tsb_track_progress_color="@android:color/darker_gray"
                    app:tsb_track_progress_size="3dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.warkiz.tickseekbar.TickSeekBar
                    android:id="@+id/listener2"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_margin="@dimen/margin_medium"
                    android:layout_weight="1"
                    app:tsb_max="99"
                    app:tsb_min="1"
                    app:tsb_progress="50"
                    app:tsb_show_tick_marks_type="oval"
                    app:tsb_show_tick_texts="above"
                    app:tsb_thumb_color="@color/colorAccent"
                    app:tsb_thumb_size="16dp"
                    app:tsb_tick_marks_color="@color/colorAccent"
                    app:tsb_tick_marks_size="8dp"
                    app:tsb_tick_texts_color="@android:color/darker_gray"
                    app:tsb_tick_texts_size="13sp"
                    app:tsb_ticks_count="11"
                    app:tsb_track_background_color="@android:color/darker_gray"
                    app:tsb_track_background_size="2dp"
                    app:tsb_track_progress_color="@android:color/darker_gray"
                    app:tsb_track_progress_size="3dp" />


            </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/margin_medium"
                    android:src="@drawable/new_agribot" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/margin_large" />

                <com.warkiz.tickseekbar.TickSeekBar
                    android:id="@+id/listener3"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_margin="@dimen/margin_medium"
                    android:layout_weight="1"
                    app:tsb_max="99"
                    app:tsb_min="1"
                    app:tsb_progress="50"
                    app:tsb_show_tick_marks_type="oval"
                    app:tsb_show_tick_texts="above"
                    app:tsb_thumb_color="@color/colorAccent"
                    app:tsb_thumb_size="16dp"
                    app:tsb_tick_marks_color="@color/colorAccent"
                    app:tsb_tick_marks_size="8dp"
                    app:tsb_tick_texts_color="@android:color/darker_gray"
                    app:tsb_tick_texts_size="13sp"
                    app:tsb_ticks_count="11"
                    app:tsb_track_background_color="@android:color/darker_gray"
                    app:tsb_track_background_size="2dp"
                    app:tsb_track_progress_color="@android:color/darker_gray"
                    app:tsb_track_progress_size="3dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.warkiz.tickseekbar.TickSeekBar
                    android:id="@+id/listener4"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_margin="@dimen/margin_medium"
                    android:layout_weight="1"
                    app:tsb_max="99"
                    app:tsb_min="1"
                    app:tsb_progress="50"
                    app:tsb_show_tick_marks_type="oval"
                    app:tsb_show_tick_texts="above"
                    app:tsb_thumb_color="@color/colorAccent"
                    app:tsb_thumb_size="16dp"
                    app:tsb_tick_marks_color="@color/colorAccent"
                    app:tsb_tick_marks_size="8dp"
                    app:tsb_tick_texts_color="@android:color/darker_gray"
                    app:tsb_tick_texts_size="13sp"
                    app:tsb_ticks_count="11"
                    app:tsb_track_background_color="@android:color/darker_gray"
                    app:tsb_track_background_size="2dp"
                    app:tsb_track_progress_color="@android:color/darker_gray"
                    app:tsb_track_progress_size="3dp" />
            </LinearLayout>


        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@android:color/darker_gray" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_xxlarge" />

                    <Switch
                        android:id="@+id/left_pto_switch"
                        style="@style/AgribotSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/margin_medium" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_xxlarge" />

                    <Switch
                        android:id="@+id/left_blue_switch"
                        style="@style/AgribotSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/margin_medium" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_xxlarge" />

                    <Switch
                        android:id="@+id/left_yellow_switch"
                        style="@style/AgribotSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/margin_large" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_xxlarge" />

                    <Switch
                        android:id="@+id/left_green_switch"
                        style="@style/AgribotSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/margin_medium" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/pto"
                        android:textSize="@dimen/text_size_xlarge"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatSeekBar
                        android:id="@+id/left_pto_slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_medium"
                        android:background="@android:color/white"
                        android:max="100"
                        android:progressDrawable="@drawable/slider_progress"
                        android:splitTrack="false"
                        android:theme="@style/Widget.AppCompat.SeekBar.Discrete"
                        android:thumb="@drawable/slider_thumb"
                        app:tickMark="@null" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/blue_tool"
                        android:textSize="@dimen/text_size_xlarge"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatSeekBar
                        android:id="@+id/left_blue_slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_medium"
                        android:background="@android:color/white"
                        android:max="100"
                        android:progressDrawable="@drawable/slider_progress"
                        android:splitTrack="false"
                        android:theme="@style/Widget.AppCompat.SeekBar.Discrete"
                        android:thumb="@drawable/slider_thumb"
                        app:tickMark="@null" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/yellow_tool"
                        android:textSize="@dimen/text_size_xlarge"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatSeekBar
                        android:id="@+id/left_yellow_slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_medium"
                        android:background="@android:color/white"
                        android:max="100"
                        android:progressDrawable="@drawable/slider_progress"
                        android:splitTrack="false"
                        android:theme="@style/Widget.AppCompat.SeekBar.Discrete"
                        android:thumb="@drawable/slider_thumb"
                        app:tickMark="@null" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/green_tool"
                        android:textSize="@dimen/text_size_xlarge"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatSeekBar
                        android:id="@+id/left_green_slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_medium"
                        android:background="@android:color/white"
                        android:max="100"
                        android:progressDrawable="@drawable/slider_progress"
                        android:splitTrack="false"
                        android:theme="@style/Widget.AppCompat.SeekBar.Discrete"
                        android:thumb="@drawable/slider_thumb"
                        app:tickMark="@null" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_xxlarge" />

                    <TextView
                        android:id="@+id/left_pto_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_medium"
                        android:background="@drawable/shape_gears_background_transparent"
                        android:gravity="center"
                        android:padding="@dimen/margin_small"
                        android:text="@{viewModel.leftPTO}"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_xxlarge" />

                    <TextView
                        android:id="@+id/left_blue_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_medium"
                        android:background="@drawable/shape_gears_background_transparent"
                        android:gravity="center"
                        android:padding="@dimen/margin_small"
                        android:text="@{viewModel.leftBlue}"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_xxlarge" />

                    <TextView
                        android:id="@+id/left_yellow_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_medium"
                        android:background="@drawable/shape_gears_background_transparent"
                        android:gravity="center"
                        android:padding="@dimen/margin_small"
                        android:text="@{viewModel.leftYellow}"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_xxlarge" />

                    <TextView
                        android:id="@+id/left_green_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_medium"
                        android:background="@drawable/shape_gears_background_transparent"
                        android:gravity="center"
                        android:padding="@dimen/margin_small"
                        android:text="@{viewModel.leftGreen}"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold" />


                </LinearLayout>


            </LinearLayout>

            <View
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:background="@android:color/darker_gray" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_xxlarge" />

                    <Switch
                        android:id="@+id/right_pto_switch"
                        style="@style/AgribotSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/margin_medium" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_xxlarge" />

                    <Switch
                        android:id="@+id/right_blue_switch"
                        style="@style/AgribotSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/margin_medium" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_xxlarge" />

                    <Switch
                        android:id="@+id/right_yellow_switch"
                        style="@style/AgribotSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/margin_large" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_xxlarge" />

                    <Switch
                        android:id="@+id/right_green_switch"
                        style="@style/AgribotSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/margin_medium" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/pto"
                        android:textSize="@dimen/text_size_xlarge"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatSeekBar
                        android:id="@+id/right_pto_slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_medium"
                        android:background="@android:color/white"
                        android:max="100"
                        android:progressDrawable="@drawable/slider_progress"
                        android:splitTrack="false"
                        android:theme="@style/Widget.AppCompat.SeekBar.Discrete"
                        android:thumb="@drawable/slider_thumb"
                        app:tickMark="@null" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/blue_tool"
                        android:textSize="@dimen/text_size_xlarge"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatSeekBar
                        android:id="@+id/right_blue_slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_medium"
                        android:background="@android:color/white"
                        android:max="100"
                        android:progressDrawable="@drawable/slider_progress"
                        android:splitTrack="false"
                        android:theme="@style/Widget.AppCompat.SeekBar.Discrete"
                        android:thumb="@drawable/slider_thumb"
                        app:tickMark="@null" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/yellow_tool"
                        android:textSize="@dimen/text_size_xlarge"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatSeekBar
                        android:id="@+id/right_yellow_slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_medium"
                        android:background="@android:color/white"
                        android:max="100"
                        android:progressDrawable="@drawable/slider_progress"
                        android:splitTrack="false"
                        android:theme="@style/Widget.AppCompat.SeekBar.Discrete"
                        android:thumb="@drawable/slider_thumb"
                        app:tickMark="@null" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/green_tool"
                        android:textSize="@dimen/text_size_xlarge"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatSeekBar
                        android:id="@+id/right_green_slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_medium"
                        android:background="@android:color/white"
                        android:max="100"
                        android:progressDrawable="@drawable/slider_progress"
                        android:splitTrack="false"
                        android:theme="@style/Widget.AppCompat.SeekBar.Discrete"
                        android:thumb="@drawable/slider_thumb"
                        app:tickMark="@null" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_xxlarge" />

                    <TextView
                        android:id="@+id/right_pto_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_medium"
                        android:background="@drawable/shape_gears_background_transparent"
                        android:gravity="center"
                        android:padding="@dimen/margin_small"
                        android:text="@{viewModel.rightPTO}"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_xxlarge" />

                    <TextView
                        android:id="@+id/right_blue_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_medium"
                        android:background="@drawable/shape_gears_background_transparent"
                        android:gravity="center"
                        android:padding="@dimen/margin_small"
                        android:text="@{viewModel.rightBlue}"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_xxlarge" />

                    <TextView
                        android:id="@+id/right_yellow_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_medium"
                        android:background="@drawable/shape_gears_background_transparent"
                        android:gravity="center"
                        android:padding="@dimen/margin_small"
                        android:text="@{viewModel.rightYellow}"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_xxlarge" />

                    <TextView
                        android:id="@+id/right_green_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/margin_medium"
                        android:background="@drawable/shape_gears_background_transparent"
                        android:gravity="center"
                        android:padding="@dimen/margin_small"
                        android:text="@{viewModel.rightGreen}"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold" />


                </LinearLayout>


            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</layout>