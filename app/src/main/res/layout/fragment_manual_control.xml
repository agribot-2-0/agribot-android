<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="eu.agribot.agribotapp.ui.fragment.manualcontrol.ManualControlViewModel" />
    </data>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:background="@color/background_gray">



        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="3"
            android:layout_height="match_parent"
            android:orientation="vertical">

           <androidx.viewpager2.widget.ViewPager2
               android:id="@+id/manualControlViewPager"
               android:layout_width="match_parent"
               android:layout_height="match_parent"/>


        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/margin_small"
            android:layout_marginEnd="@dimen/text_size_medium"
            android:layout_marginVertical="@dimen/text_size_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/margin_small"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/margin_large"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_button"
                    android:onClick="@{() -> viewModel.onToolControlClicked()}"
                    android:text="@string/title_tool_control"
                    tools:ignore="NestedWeights" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="2"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="3">

                    <io.github.controlwear.virtual.joystick.android.JoystickView
                        xmlns:custom="http://schemas.android.com/apk/res-auto"
                        android:id="@+id/manual_mode_joystick"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="@dimen/margin_small"
                        android:layout_gravity="center"
                        android:background="@drawable/ic_joystick_background"
                        custom:JV_borderWidth="2dp"
                        custom:JV_buttonColor="@color/base_green"
                        custom:JV_backgroundSizeRatio="80%"
                        custom:JV_buttonSizeRatio="15%"
                        custom:JV_fixedCenter="false" />



                </androidx.cardview.widget.CardView>






            </LinearLayout>
        </androidx.cardview.widget.CardView>






    </LinearLayout>
</layout>
