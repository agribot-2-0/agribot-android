<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="eu.agribot.agribotapp.ui.fragment.bluetoothconnection.recycler.BluetoothNearbyListItemViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bluetooth_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_margin="@dimen/margin_medium"
            android:text="@{viewModel.bluetoothName}"
            android:textColor="?android:textColorPrimary"
            android:textSize="@dimen/text_size_xlarge"
            tools:text="NAME" />

        <TextView
            android:id="@+id/Bluetooth_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_margin="@dimen/margin_medium"
            android:text="@{viewModel.bluetoothAddress}"
            android:textColor="?android:textColorPrimary"
            android:textSize="@dimen/text_size_xlarge"
            tools:text="ADRESS" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_margin="@dimen/margin_medium"
            android:background="@android:color/darker_gray"/>

    </LinearLayout>
</layout>