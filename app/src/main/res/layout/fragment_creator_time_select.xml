<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="eu.agribot.agribotapp.ui.fragment.taskcreator.timeselect.CreatorTimeSelectViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_gray"
        android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="7"
                android:layout_margin="@dimen/margin_small"
                android:background="@drawable/rounded_corner_layout"
                android:gravity="center">


                <DatePicker
                    android:id="@+id/date_picker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/margin_medium"
                    android:datePickerMode="spinner" />

                <TimePicker
                    android:id="@+id/time_picker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/margin_medium"
                    android:timePickerMode="clock" />


                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/time_activator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:checked="@{viewModel.isTimePreset()}"
                    android:layout_marginHorizontal="@dimen/margin_large" />

            </LinearLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="@dimen/margin_small"
            android:layout_weight="1"
            android:background="@drawable/rounded_corner_layout"
            android:gravity="end"
            android:orientation="horizontal">

            <eu.agribot.agribotapp.ui.ViewBottomItemDetails
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:progressValue="40"
                app:fourthButtonText="@string/next_button"/>

        </androidx.constraintlayout.widget.ConstraintLayout>


    </LinearLayout>

</layout>