<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation_main"
    app:startDestination="@id/dashboardFragment"
    tools:ignore="UnusedNavigation">

    <fragment
        android:id="@+id/manualControlFragment"
        android:name="eu.agribot.agribotapp.ui.fragment.manualcontrol.ManualControlFragment"
        android:label="@string/title_manual_control"
        tools:layout="@layout/fragment_manual_control">

        <action
            android:id="@+id/action_manualControlFragment_to_toolControlFragment"
            app:destination="@id/toolControlFragment"
            app:enterAnim="@anim/nav_slide_in_from_right"
            app:exitAnim="@anim/nav_slide_out_to_right"
            app:popEnterAnim="@anim/nav_slide_out_to_left"
            app:popExitAnim="@anim/nav_slide_in_from_left" />

        <action
            android:id="@+id/action_manualControlFragment_to_overrideFragment"
            app:destination="@id/overrideMode"
            app:enterAnim="@anim/nav_slide_in_from_right"
            app:exitAnim="@anim/nav_slide_out_to_right"
            app:popEnterAnim="@anim/nav_slide_out_to_left"
            app:popExitAnim="@anim/nav_slide_in_from_left" />

        <action
            android:id="@+id/action_manualControlFragment_to_bluetoothConnectionFragment"
            app:destination="@id/bluetoothConnectFragment"
            app:enterAnim="@anim/nav_slide_in_from_right"
            app:exitAnim="@anim/nav_slide_out_to_right"
            app:popEnterAnim="@anim/nav_slide_out_to_left"
            app:popExitAnim="@anim/nav_slide_in_from_left" />

    </fragment>

    <fragment
        android:id="@+id/findToolFragment"
        android:name="eu.agribot.agribotapp.ui.fragment.toolmanagement.findtag.FindToolTagFragment"
        android:label="@string/title_manual_control"
        tools:layout="@layout/fragment_find_tool_tag">

        <action
            android:id="@+id/action_findToolFragment_to_shotToolPhoto"
            app:destination="@id/shotToolPhoto" />
    </fragment>

    <fragment
        android:id="@+id/overrideMode"
        android:name="eu.agribot.agribotapp.ui.fragment.ttcontrol.TTControlModeFragment"
        android:label="Override Mode"
        tools:layout="@layout/fragment_ttcontrol">


    </fragment>


    <fragment
        android:id="@+id/shotToolPhoto"
        android:name="eu.agribot.agribotapp.ui.fragment.toolmanagement.tooltagphoto.ToolTagPhotoFragment"
        android:label="Override Mode"
        tools:layout="@layout/fragment_create_photo">


        <action
            android:id="@+id/action_shotToolPhoto_to_displayToolPhoto"
            app:destination="@id/displayToolPhoto" />
    </fragment>


    <fragment
        android:id="@+id/displayToolPhoto"
        android:name="eu.agribot.agribotapp.ui.fragment.toolmanagement.displaytoolphoto.DisplayToolPhotoFragment"
        android:label="Override Mode"
        tools:layout="@layout/fragment_display_tool_photo">


        <action
            android:id="@+id/action_displayToolPhoto_to_toolManagementParamsFragment"
            app:destination="@id/toolManagementParamsFragment" />
        <action
            android:id="@+id/action_displayToolPhoto_to_shotToolPhoto"
            app:destination="@id/shotToolPhoto" />
    </fragment>


    <fragment
        android:id="@+id/bluetoothConnectFragment"
        android:name="eu.agribot.agribotapp.ui.fragment.bluetoothconnection.BluetoothConnectionFragment"
        android:label="BluetoothConnect"
        tools:layout="@layout/fragment_bluetooth_connection">

        <action
            android:id="@+id/action_bluetoothConnectionFragment_to_manualControlFragment"
            app:destination="@id/manualControlFragment"
            app:enterAnim="@anim/nav_slide_in_from_right"
            app:exitAnim="@anim/nav_slide_out_to_right"
            app:popEnterAnim="@anim/nav_slide_out_to_left"
            app:popExitAnim="@anim/nav_slide_in_from_left" />
    </fragment>


    <fragment
        android:id="@+id/toolManagementFragment"
        android:name="eu.agribot.agribotapp.ui.fragment.toolmanagement.mainscreen.ToolManagementFragment"
        android:label="@string/title_tool_management"
        tools:layout="@layout/fragment_tool_management" >
        <action
            android:id="@+id/action_toolManagementFragment_to_toolManagementNameFragment"
            app:destination="@id/toolManagementNameFragment"
            app:enterAnim="@anim/nav_slide_in_from_right"
            app:exitAnim="@anim/nav_slide_out_to_right"
            app:popEnterAnim="@anim/nav_slide_out_to_left"
            app:popExitAnim="@anim/nav_slide_in_from_left"/>
        <action
            android:id="@+id/action_toolManagementFragment_to_toolManagementSummaryFragment"
            app:destination="@id/toolManagementSummaryFragment" />
    </fragment>

    <fragment
        android:id="@+id/toolManagementNameFragment"
        android:name="eu.agribot.agribotapp.ui.fragment.toolmanagement.toolname.ToolNameFragment"
        android:label="@string/title_tool_management"
        tools:layout="@layout/fragment_tool_management_name" >
        <action
            android:id="@+id/action_toolManagementNameFragment_to_findToolFragment"
            app:destination="@id/findToolFragment" />
    </fragment>

    <fragment
        android:id="@+id/toolManagementParamsFragment"
        android:name="eu.agribot.agribotapp.ui.fragment.toolmanagement.toolparameters.ToolParamsFragment"
        android:label="@string/title_tool_management"
        tools:layout="@layout/fragment_tool_management_params" >
        <action
            android:id="@+id/action_toolManagementParamsFragment_to_toolManagementSummaryFragment"
            app:destination="@id/toolManagementSummaryFragment" />
    </fragment>

    <fragment
        android:id="@+id/toolManagementSummaryFragment"
        android:name="eu.agribot.agribotapp.ui.fragment.toolmanagement.toolsummary.ToolSummaryFragment"
        android:label="@string/title_tool_management"
        tools:layout="@layout/fragment_tool_management_params" >
        <action
            android:id="@+id/action_toolManagementSummaryFragment_to_toolManagementFragment"
            app:destination="@id/toolManagementFragment" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="eu.agribot.agribotapp.ui.fragment.controlPanel.ControlPanelFragment"
        android:label="@string/title_dashboard"
        tools:layout="@layout/fragment_control_panel">

        <action
            android:id="@+id/action_dashboard_to_taskSelectFragment"
            app:destination="@id/selectTaskFragment"
            app:enterAnim="@anim/nav_slide_in_from_right"
            app:exitAnim="@anim/nav_slide_out_to_right"
            app:popEnterAnim="@anim/nav_slide_out_to_left"
            app:popExitAnim="@anim/nav_slide_in_from_left" />
    </fragment>

    <fragment
        android:id="@+id/pathManagementFragment"
        android:name="eu.agribot.agribotapp.ui.fragment.pathmanagement.mainpathscreen.PathManagementFragment"
        android:label="@string/title_path_management"
        tools:layout="@layout/fragment_path_management" >
        <action
            android:id="@+id/action_pathManagementFragment_to_newPathFragment"
            app:destination="@id/newPathFragment" />
        <action
            android:id="@+id/action_pathManagementFragment_to_pathNameFragment"
            app:destination="@id/pathNameFragment" />
    </fragment>

    <fragment
        android:id="@+id/weatherFragment"
        android:name="eu.agribot.agribotapp.ui.fragment.weather.WeatherFragment"
        android:label="@string/title_weather"
        tools:layout="@layout/fragment_weather" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="eu.agribot.agribotapp.ui.fragment.settings.SettingsFragment"
        android:label="@string/title_settings"
        tools:layout="@layout/fragment_settings">

        <action
            android:id="@+id/action_settingsFragment_to_bluetoothConnectionFragment"
            app:destination="@id/bluetoothConnectFragment"
            app:enterAnim="@anim/nav_slide_in_from_right"
            app:exitAnim="@anim/nav_slide_out_to_right"
            app:popEnterAnim="@anim/nav_slide_out_to_left"
            app:popExitAnim="@anim/nav_slide_in_from_left" />
        <action
            android:id="@+id/action_settingsFragment_to_manualControlFragment"
            app:destination="@id/manualControlFragment" />
    </fragment>

    <fragment
        android:id="@+id/toolControlFragment"
        android:name="eu.agribot.agribotapp.ui.fragment.toolcontrol.ToolControlFragment"
        android:label="@string/title_tool_control"
        tools:layout="@layout/fragment_tool_control" />

    <fragment
        android:id="@+id/taskCreatorTaskNameFragment"
        android:name="eu.agribot.agribotapp.ui.fragment.taskcreator.taskname.CreatorTaskNameFragment"
        android:label="@string/type_task_name"
        tools:layout="@layout/fragment_creator_task_name">


        <action
            android:id="@+id/action_taskNameCreatorFragment_to_taskPathCreatorFragment"
            app:destination="@id/taskCreatorTaskPathFragment"
            app:enterAnim="@anim/nav_slide_in_from_right"
            app:exitAnim="@anim/nav_slide_out_to_right"
            app:popEnterAnim="@anim/nav_slide_out_to_left"
            app:popExitAnim="@anim/nav_slide_in_from_left" />


    </fragment>

    <fragment
        android:id="@+id/taskCreatorTaskPathFragment"
        android:name="eu.agribot.agribotapp.ui.fragment.taskcreator.pathselect.CreatorPathSelectFragment"
        android:label="@string/choose_path_for_the_agribot"
        tools:layout="@layout/fragment_creator_path_select">

        <action
            android:id="@+id/action_taskPathCreatorFragment_to_taskTimeCreatorFragment"
            app:destination="@id/taskCreatorTaskTimeFragment"
            app:enterAnim="@anim/nav_slide_in_from_right"
            app:exitAnim="@anim/nav_slide_out_to_right"
            app:popEnterAnim="@anim/nav_slide_out_to_left"
            app:popExitAnim="@anim/nav_slide_in_from_left" />
        <action
            android:id="@+id/action_taskCreatorTaskPathFragment_to_creatorFragment"
            app:destination="@id/creatorFragment"
            app:enterAnim="@anim/nav_slide_in_from_right"
            app:exitAnim="@anim/nav_slide_out_to_right"
            app:popEnterAnim="@anim/nav_slide_out_to_left"
            app:popExitAnim="@anim/nav_slide_in_from_left"/>

    </fragment>

    <fragment
        android:id="@+id/taskCreatorTaskTimeFragment"
        android:name="eu.agribot.agribotapp.ui.fragment.taskcreator.timeselect.CreatorTimeSelectFragment"
        android:label="@string/choose_time"
        tools:layout="@layout/fragment_creator_time_select">

        <action
            android:id="@+id/action_taskTimeCreatorFragment_to_taskWeatherCreatorFragment"
            app:destination="@id/taskCreatorTaskWeatherFragment"
            app:enterAnim="@anim/nav_slide_in_from_right"
            app:exitAnim="@anim/nav_slide_out_to_right"
            app:popEnterAnim="@anim/nav_slide_out_to_left"
            app:popExitAnim="@anim/nav_slide_in_from_left" />
        <action
            android:id="@+id/action_taskCreatorTaskTimeFragment_to_taskCreatorTaskPathFragment"
            app:destination="@id/taskCreatorTaskPathFragment"
            app:enterAnim="@anim/nav_slide_in_from_right"
            app:exitAnim="@anim/nav_slide_out_to_right"
            app:popEnterAnim="@anim/nav_slide_out_to_left"
            app:popExitAnim="@anim/nav_slide_in_from_left" />

    </fragment>

    <fragment
        android:id="@+id/taskCreatorTaskWeatherFragment"
        android:name="eu.agribot.agribotapp.ui.fragment.taskcreator.weatherselect.CreatorWeatherSelectFragment"
        android:label="@string/select_weather_parameters"
        tools:layout="@layout/fragment_creator_weather">

        <action
            android:id="@+id/action_taskWeatherCreatorFragment_to_taskToolCreatorFragment"
            app:destination="@id/taskCreatorTaskToolFragment"
            app:enterAnim="@anim/nav_slide_in_from_right"
            app:exitAnim="@anim/nav_slide_out_to_right"
            app:popEnterAnim="@anim/nav_slide_out_to_left"
            app:popExitAnim="@anim/nav_slide_in_from_left" />
        <action
            android:id="@+id/action_taskCreatorTaskWeatherFragment_to_taskCreatorTaskTimeFragment"
            app:destination="@id/taskCreatorTaskTimeFragment"
            app:enterAnim="@anim/nav_slide_in_from_right"
            app:exitAnim="@anim/nav_slide_out_to_right"
            app:popEnterAnim="@anim/nav_slide_out_to_left"
            app:popExitAnim="@anim/nav_slide_in_from_left" />

    </fragment>

    <fragment
        android:id="@+id/taskCreatorTaskToolFragment"
        android:name="eu.agribot.agribotapp.ui.fragment.taskcreator.toolselect.CreatorToolSelectFragment"
        android:label="@string/select_tool"
        tools:layout="@layout/fragment_creator_tool_select">

        <action
            android:id="@+id/action_taskCreatorTaskToolFragment_to_taskCreatorTaskWeatherFragment"
            app:destination="@id/taskCreatorTaskWeatherFragment"
            app:enterAnim="@anim/nav_slide_in_from_right"
            app:exitAnim="@anim/nav_slide_out_to_right"
            app:popEnterAnim="@anim/nav_slide_out_to_left"
            app:popExitAnim="@anim/nav_slide_in_from_left" />
        <action
            android:id="@+id/action_taskCreatorTaskToolFragment_to_creatorFragment"
            app:destination="@id/creatorFragment"
            app:enterAnim="@anim/nav_slide_in_from_right"
            app:exitAnim="@anim/nav_slide_out_to_right"
            app:popEnterAnim="@anim/nav_slide_out_to_left"
            app:popExitAnim="@anim/nav_slide_in_from_left" />
    </fragment>

    <fragment
        android:id="@+id/selectTaskFragment"
        android:name="eu.agribot.agribotapp.ui.fragment.controlPanel.taskselect.TaskSelectFragment"
        android:label="@string/select_task_label"
        tools:layout="@layout/fragment_task_select">

        <action
            android:id="@+id/action_selectTaskFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:enterAnim="@anim/nav_slide_in_from_right"
            app:exitAnim="@anim/nav_slide_out_to_right"
            app:popEnterAnim="@anim/nav_slide_out_to_left"
            app:popExitAnim="@anim/nav_slide_in_from_left" />

    </fragment>

    <fragment
        android:id="@+id/creatorFragment"
        android:name="eu.agribot.agribotapp.ui.fragment.taskcreator.mainscreen.TaskCreatorFragment"
        android:label="@string/title_task_creator"
        tools:layout="@layout/fragment_creator_configurator">

        <action
            android:id="@+id/action_taskCreatorFragment_to_taskNameCreatorFragment"
            app:destination="@id/taskCreatorTaskNameFragment"
            app:enterAnim="@anim/nav_slide_in_from_right"
            app:exitAnim="@anim/nav_slide_out_to_right"
            app:popEnterAnim="@anim/nav_slide_out_to_left"
            app:popExitAnim="@anim/nav_slide_in_from_left" />

        <action
            android:id="@+id/action_taskCreatorFragment_to_taskPathCreatorFragment"
            app:destination="@id/taskCreatorTaskPathFragment"
            app:enterAnim="@anim/nav_slide_in_from_right"
            app:exitAnim="@anim/nav_slide_out_to_right"
            app:popEnterAnim="@anim/nav_slide_out_to_left"
            app:popExitAnim="@anim/nav_slide_in_from_left" />

    </fragment>
    <fragment
        android:id="@+id/newPathFragment"
        android:name="eu.agribot.agribotapp.ui.fragment.pathmanagement.newpath.NewPathFragment"
        android:label="@string/title_path_management">
        <action
            android:id="@+id/action_newPathFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment" />
        <action
            android:id="@+id/action_newPathFragment_to_pathManagementFragment"
            app:destination="@id/pathManagementFragment" />
    </fragment>

    <fragment
        android:id="@+id/pathNameFragment"
        android:name="eu.agribot.agribotapp.ui.fragment.pathmanagement.pathname.PathNameFragment"
        android:label="@string/title_path_management">
        <action
            android:id="@+id/action_pathNameFragment_to_newPathFragment"
            app:destination="@id/newPathFragment" />
    </fragment>

</navigation>
