<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <variable
            name="viewModel"
            type="eu.agribot.agribotapp.ui.dashboard.DashboardViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shape_background_transparent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include layout="@layout/view_status" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <include layout="@layout/view_path_select" />

            </FrameLayout>

            <View
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:background="@android:color/darker_gray" />


            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/base_green">

                <fragment
                    android:id="@+id/map"
                    android:name="com.google.android.gms.maps.SupportMapFragment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </FrameLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@android:color/darker_gray" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <include layout="@layout/view_calendar" />
            </FrameLayout>

            <View
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:background="@android:color/darker_gray" />


            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <include layout="@layout/view_tool_select" />

            </FrameLayout>


        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@android:color/darker_gray" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/selectedDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="@dimen/margin_medium"
                android:layout_marginStart="@dimen/view_start_stop_margin"
                android:text="@string/view_start_stop_today"
                android:textSize="@dimen/view_start_stop_text_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/selectedTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="@dimen/margin_medium"
                android:layout_marginStart="@dimen/view_start_stop_margin"
                android:text="@string/view_start_stop_now"
                android:textSize="@dimen/view_start_stop_text_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/selectedWeather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="@dimen/margin_medium"
                android:layout_marginStart="@dimen/view_start_stop_margin"
                android:text="@string/no_weather"
                android:textSize="@dimen/view_start_stop_text_size"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/visInWindIc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="@dimen/margin_medium"
                android:layout_marginStart="@dimen/view_start_stop_margin"
                android:src="@drawable/ic_wind"
                android:visibility="visible" />

            <ImageView
                android:id="@+id/visInTempIc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="@dimen/margin_medium"
                android:layout_marginStart="@dimen/view_start_stop_margin"
                android:src="@drawable/ic_celsius"
                android:visibility="visible" />

            <ImageView
                android:id="@+id/visInHumiIc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="@dimen/margin_medium"
                android:layout_marginStart="@dimen/view_start_stop_margin"
                android:src="@drawable/ic_humidity"
                android:visibility="visible" />

            <ImageView
                android:id="@+id/visInPressIc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="@dimen/margin_medium"
                android:layout_marginStart="@dimen/view_start_stop_margin"
                android:src="@drawable/ic_pressure"
                android:visibility="visible" />


            <Button
                android:id="@+id/progAndStart_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="@dimen/margin_medium"
                android:layout_marginStart="@dimen/view_start_stop_margin"
                android:layout_marginEnd="@dimen/view_start_stop_margin"
                android:background="@drawable/start_button_shape"
                android:onClick="@{() -> viewModel.sendInitAutoMode()}"
                android:padding="@dimen/margin_medium"
                android:shadowColor="#40A858"
                android:shadowRadius="5"
                android:text="@string/start_now"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_size_medium" />


        </LinearLayout>


    </LinearLayout>

</layout>