<?xml version="1.0" encoding="utf-8"?>
<LinearLayout

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/shape_background_transparent"
    android:gravity="center"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:id="@+id/selectedDate"
        android:layout_width="0dp"
        android:layout_weight="3"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/margin_medium"
        android:layout_marginStart="@dimen/view_start_stop_margin"
        android:text="@string/view_start_stop_today"
        android:textSize="@dimen/view_start_stop_text_size"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/selectedTime"
        android:layout_width="0dp"
        android:layout_weight="3"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/margin_medium"
        android:layout_marginStart="@dimen/view_start_stop_margin"
        android:text="@string/view_start_stop_now"
        android:textSize="@dimen/view_start_stop_text_size"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/selectedWeather"
        android:layout_width="0dp"
        android:layout_weight="8"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/margin_medium"
        android:layout_marginStart="@dimen/view_start_stop_margin"
        android:text="@string/no_weather"
        android:textSize="@dimen/view_start_stop_text_size"
        android:textStyle="bold"/>

    <ImageView
        android:id="@+id/visInWindIc"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/margin_medium"
        android:layout_marginStart="@dimen/view_start_stop_margin"
        android:src="@drawable/ic_wind"
        android:visibility="visible" />

    <ImageView
        android:id="@+id/visInTempIc"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/margin_medium"
        android:layout_marginStart="@dimen/view_start_stop_margin"
        android:src="@drawable/ic_celsius"
        android:visibility="visible" />

    <ImageView
        android:id="@+id/visInHumiIc"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/margin_medium"
        android:layout_marginStart="@dimen/view_start_stop_margin"
        android:src="@drawable/ic_humidity"
        android:visibility="visible" />

    <ImageView
        android:id="@+id/visInPressIc"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/margin_medium"
        android:layout_marginStart="@dimen/view_start_stop_margin"
        android:src="@drawable/ic_pressure"
        android:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/progAndStart_btn"
        android:layout_width="0dp"
        android:layout_weight="4"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin_medium"
        android:layout_marginVertical="@dimen/margin_medium"
        android:layout_marginStart="@dimen/view_start_stop_margin"
        android:layout_marginEnd="@dimen/view_start_stop_margin"
        android:background="@drawable/start_button_shape"
        android:shadowColor="#40A858"
        android:shadowRadius="5"
        android:text="@string/start_now"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_size_medium" />

</LinearLayout>


