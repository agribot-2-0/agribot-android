<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="viewModel"
            type="eu.agribot.agribotapp.ui.fragment.manualcontrol.viewpager.toolcontrol.ToolControlViewModel" />
    </data>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@color/background_gray"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:orientation="horizontal">


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <CheckBox
                    android:id="@+id/checkBox_front_tpl_up"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_margin="@dimen/margin_medium"
                    android:gravity="bottom"
                    android:layout_weight="1"
                    android:padding="@dimen/margin_small" />

                <CheckBox
                    android:id="@+id/checkBox_front_tpl_down"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_margin="@dimen/margin_medium"
                    android:layout_weight="1"
                    android:padding="@dimen/margin_small" />

            </LinearLayout>


            <ImageView
                android:id="@+id/imageView"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_small"
                android:src="@drawable/agribot" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <CheckBox
                    android:id="@+id/checkBox_back_tpl_up"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:gravity="bottom"
                    android:layout_margin="@dimen/margin_medium"
                    android:layout_weight="1"
                    android:padding="@dimen/margin_small" />

                <CheckBox
                    android:id="@+id/checkBox_back_tpl_down"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_margin="@dimen/margin_medium"
                    android:padding="@dimen/margin_small" />



            </LinearLayout>

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/appCompatSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:onProgressChanged="@{(seekBar, progress, fromUser) -> viewModel.onTuzParametersChanged(progress)}"
            android:padding="@dimen/margin_small"
            android:progress="50"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageView" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_medium">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                android:layout_weight="1"
                android:padding="@dimen/margin_small"
                android:background="@drawable/rounded_corner_layout"
                android:gravity="center"
                android:text="@string/front_hitch"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                android:layout_weight="1"
                android:padding="@dimen/margin_small"
                android:background="@drawable/rounded_corner_layout"
                android:gravity="center"
                android:text="@string/back_hitch"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:layout_margin="@dimen/margin_small"
          >

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/front_hitch_recycler"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/margin_medium"
                android:layout_weight="1"
                android:background="@drawable/rounded_corner_layout"
                android:nestedScrollingEnabled="false"
                android:padding="@dimen/margin_small" />


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/back_hitch_recycler"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/margin_medium"
                android:layout_weight="1"
                android:background="@drawable/rounded_corner_layout"
                android:nestedScrollingEnabled="false"
                android:padding="@dimen/margin_small" />

        </LinearLayout>

    </LinearLayout>


</layout>