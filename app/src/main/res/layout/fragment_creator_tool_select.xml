<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="eu.agribot.agribotapp.ui.fragment.taskcreator.toolselect.CreatorToolSelectViewModel" />
    </data>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_gray"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_margin="@dimen/margin_small"
            android:layout_weight="1"
            android:background="@drawable/rounded_corner_layout"
            android:orientation="horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_small"
                android:layout_weight="10"
                android:text="@string/step_4"
                android:textSize="@dimen/text_size_xlarge"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_small"
                android:layout_weight="1"

                android:text="@string/select_tool"
                android:textSize="@dimen/text_size_large"
                android:textStyle="bold" />


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="7"
            android:layout_margin="@dimen/margin_small"
            android:orientation="horizontal"
            android:background="@color/background_gray">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/margin_small"

                android:layout_weight="2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>


                    <ImageView
                        android:id="@+id/imageView3"
                        android:layout_width="617dp"
                        android:layout_height="397dp"
                        android:layout_gravity="center"
                        android:src="@drawable/agribot" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>



                </LinearLayout>

            </androidx.cardview.widget.CardView>


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="@dimen/margin_small"
            android:background="@drawable/rounded_corner_layout"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="@dimen/margin_large"
                android:text="@string/configuration_progress" />

            <ProgressBar
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="245dp"
                android:layout_height="wrap_content"
                android:padding="@dimen/margin_large"
                android:layout_gravity="center"
                android:layout_marginHorizontal="@dimen/margin_large"
                android:progress="90" />

            <com.google.android.material.button.MaterialButton
                android:layout_width="245dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                android:layout_gravity="center"
                android:text="@string/back_button" />

            <com.google.android.material.button.MaterialButton
                android:layout_width="245dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                android:layout_gravity="center"
                android:onClick="@{() -> viewModel.sendTaskData()}"
                android:text="@string/send_to_database" />


        </LinearLayout>

    </LinearLayout>


</layout>