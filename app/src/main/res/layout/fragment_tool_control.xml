<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="viewModel"
            type="eu.agribot.agribotapp.ui.fragment.toolcontrol.ToolControlViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>


                <com.warkiz.tickseekbar.TickSeekBar
                    android:id="@+id/listener1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:tsb_min="1"
                    app:tsb_max="99"
                    app:tsb_progress="50"
                    app:tsb_ticks_count="11"
                    android:layout_margin="@dimen/margin_medium"
                    app:tsb_thumb_color="@color/colorAccent"
                    app:tsb_thumb_size="16dp"
                    app:tsb_show_tick_marks_type="oval"
                    app:tsb_tick_marks_color="@color/colorAccent"
                    app:tsb_tick_marks_size="8dp"
                    app:tsb_show_tick_texts="above"
                    app:tsb_tick_texts_color="@android:color/darker_gray"
                    app:tsb_tick_texts_size="13sp"
                    app:tsb_track_background_color="@android:color/darker_gray"
                    app:tsb_track_background_size="2dp"
                    app:tsb_track_progress_color="@android:color/darker_gray"
                    app:tsb_track_progress_size="3dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.5"/>


                <com.warkiz.tickseekbar.TickSeekBar
                    android:id="@+id/listener2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:tsb_min="1"
                    app:tsb_max="99"
                    app:tsb_progress="50"
                    app:tsb_ticks_count="11"
                    android:layout_margin="@dimen/margin_medium"
                    app:tsb_thumb_color="@color/colorAccent"
                    app:tsb_thumb_size="16dp"
                    app:tsb_show_tick_marks_type="oval"
                    app:tsb_tick_marks_color="@color/colorAccent"
                    app:tsb_tick_marks_size="8dp"
                    app:tsb_show_tick_texts="above"
                    app:tsb_tick_texts_color="@android:color/darker_gray"
                    app:tsb_tick_texts_size="13sp"
                    app:tsb_track_background_color="@android:color/darker_gray"
                    app:tsb_track_background_size="2dp"
                    app:tsb_track_progress_color="@android:color/darker_gray"
                    app:tsb_track_progress_size="3dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>


            </LinearLayout>

            <ImageView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center"
                android:layout_margin="@dimen/margin_medium"
                android:src="@drawable/new_agribot" />


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>


                <com.warkiz.tickseekbar.TickSeekBar
                    android:id="@+id/listener3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:tsb_min="1"
                    app:tsb_max="99"
                    app:tsb_progress="50"
                    app:tsb_ticks_count="11"
                    app:tsb_thumb_color="@color/colorAccent"
                    app:tsb_thumb_size="16dp"
                    android:layout_margin="@dimen/margin_medium"
                    app:tsb_show_tick_marks_type="oval"
                    app:tsb_tick_marks_color="@color/colorAccent"
                    app:tsb_tick_marks_size="8dp"
                    app:tsb_show_tick_texts="above"
                    app:tsb_tick_texts_color="@android:color/darker_gray"
                    app:tsb_tick_texts_size="13sp"
                    app:tsb_track_background_color="@android:color/darker_gray"
                    app:tsb_track_background_size="2dp"
                    app:tsb_track_progress_color="@android:color/darker_gray"
                    app:tsb_track_progress_size="3dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.5"/>


                <com.warkiz.tickseekbar.TickSeekBar
                    android:id="@+id/listener4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:tsb_ticks_count="11"
                    app:tsb_min="1"
                    app:tsb_max="99"
                    app:tsb_progress="50"
                    app:tsb_thumb_color="@color/colorAccent"
                    app:tsb_thumb_size="16dp"
                    app:tsb_show_tick_marks_type="oval"
                    app:tsb_tick_marks_color="@color/colorAccent"
                    app:tsb_tick_marks_size="8dp"
                    android:layout_margin="@dimen/margin_medium"
                    app:tsb_show_tick_texts="above"
                    app:tsb_tick_texts_color="@android:color/darker_gray"
                    app:tsb_tick_texts_size="13sp"
                    app:tsb_track_background_color="@android:color/darker_gray"
                    app:tsb_track_background_size="2dp"
                    app:tsb_track_progress_color="@android:color/darker_gray"
                    app:tsb_track_progress_size="3dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>



            </LinearLayout>

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <include
                    android:id="@+id/frontHint"
                    layout="@layout/view_hitch" />

            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <include
                    android:id="@+id/rearHint"
                    layout="@layout/view_hitch" />

            </FrameLayout>

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.5"
            tools:ignore="Suspicious0dp">

            <include
                android:id="@+id/engineStat"
                layout="@layout/view_engine" />

        </FrameLayout>

    </LinearLayout>
</layout>