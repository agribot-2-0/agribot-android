<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="viewModel"
            type="eu.agribot.agribotapp.ui.fragment.taskcreator.pathselect.CreatorPathSelectViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_gray">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/margin_medium"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@color/background_gray">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_margin="@dimen/margin_small"
                android:layout_weight="1"
                android:background="@drawable/rounded_corner_layout"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_small"
                    android:layout_weight="10"
                    android:text="@string/step_1"
                    android:textSize="@dimen/text_size_xlarge"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_small"
                    android:layout_weight="1"

                    android:text="@string/choose_path_for_the_agribot"
                    android:textSize="@dimen/text_size_large"
                    android:textStyle="bold" />


            </LinearLayout>

            <LinearLayout
            android:id="@+id/linearLayout2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="7"
                android:layout_margin="@dimen/margin_small"
                android:background="@drawable/rounded_corner_layout"
                android:gravity="center">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/margin_xlarge"
                android:layout_weight="2"
                android:background="@drawable/rounded_corner_layout"
                android:orientation="vertical">

                <fragment
                    android:id="@+id/creator_map"
                    android:name="com.google.android.gms.maps.SupportMapFragment"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_margin="@dimen/margin_medium"
                    android:layout_weight="3"
                    android:background="@drawable/rounded_corner_layout" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/margin_xlarge"
                android:layout_weight="1"
                android:background="@drawable/rounded_corner_layout"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_xlarge"
                    android:text="Your paths"
                    android:textStyle="bold" />


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_path_select"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_margin="@dimen/margin_small"
                    android:layout_weight="2" />

            </LinearLayout>


        </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_margin="@dimen/margin_small"
                android:background="@drawable/rounded_corner_layout"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/margin_large"
                    android:text="@string/configuration_progress" />

                <ProgressBar
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="245dp"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/margin_large"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/margin_large"
                    android:progress="25" />


                <com.google.android.material.button.MaterialButton
                    android:layout_width="245dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_medium"
                    android:layout_gravity="center"
                    android:onClick="@{()-> viewModel.onPreviousButtonClicked()}"
                    android:text="@string/back_button" />

                <com.google.android.material.button.MaterialButton
                    android:layout_width="245dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/margin_large"
                    android:layout_marginVertical="@dimen/margin_medium"
                    android:onClick="@{()-> viewModel.onNextButtonClicked()}"
                    android:text="@string/next_button" />


            </LinearLayout>

    </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>