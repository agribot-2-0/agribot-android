<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tool="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="eu.agribot.agribotapp.ui.fragment.manualcontrol.viewpager.toolcontrol.recycler.HitchListItemViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:orientation="vertical">

            <TextView
                android:id="@+id/recycler_tool_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{viewModel.toolName}"
                android:textSize="@dimen/text_size_medium" />

            <SeekBar
                android:id="@+id/recycler_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                android:padding="@dimen/margin_medium"
                android:progressBackgroundTint="@color/base_green" />
        </LinearLayout>


        <TextView
            android:id="@+id/recycler_tool_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_medium"
            android:layout_weight="1"
            android:textStyle="bold"
            tool:text="300" />

        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/margin_medium"
            android:background="@color/gray" />

        <TextView
            android:id="@+id/recyclerEncoderValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_medium"
            android:layout_weight="1"
            android:textColor="@color/base_green"
            android:text="@{viewModel.encoderValue}"
            android:textStyle="bold"
            tool:text="300" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/recycler_switch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_medium"
            android:layout_weight="1" />

    </LinearLayout>
</layout>