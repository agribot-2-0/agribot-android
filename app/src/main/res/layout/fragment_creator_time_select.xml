<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="eu.agribot.agribotapp.ui.fragment.taskcreator.timeselect.CreatorTimeSelectViewModel" />
    </data>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/margin_medium"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@color/background_gray">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="7"
                android:layout_margin="@dimen/margin_small"
                android:background="@drawable/rounded_corner_layout"
                android:gravity="center">


                <DatePicker
                    android:id="@+id/date_picker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/margin_medium"
                    android:datePickerMode="spinner" />

                <TimePicker
                    android:id="@+id/time_picker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/margin_medium"
                    android:timePickerMode="clock" />


                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/time_activator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/margin_large" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_margin="@dimen/margin_small"
                android:background="@drawable/rounded_corner_layout"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/margin_large"
                    android:text="@string/configuration_progress" />

                <ProgressBar
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="245dp"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/margin_large"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/margin_large"
                    android:progress="50" />


                <com.google.android.material.button.MaterialButton
                    android:layout_width="245dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_medium"
                    android:layout_gravity="center"
                    android:onClick="@{()-> viewModel.onPreviousButtonClicked()}"
                    android:text="@string/back_button" />

                <com.google.android.material.button.MaterialButton
                    android:layout_width="245dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/margin_large"
                    android:layout_marginVertical="@dimen/margin_medium"
                    android:onClick="@{()-> viewModel.onNextButtonClicked()}"
                    android:text="@string/next_button" />


            </LinearLayout>


    </LinearLayout>

</layout>