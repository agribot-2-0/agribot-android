<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tool="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="viewModel"
            type="eu.agribot.agribotapp.ui.fragment.manualcontrol.viewpager.toolcontrol.recycler.HitchListItemViewModel" />
    </data>



    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/recycler_tool_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{viewModel.toolName}"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_margin="@dimen/margin_small"
            android:textSize="@dimen/text_size_medium" />

        <SeekBar
            android:id="@+id/recycler_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_medium"
            android:padding="@dimen/margin_medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/recycler_tool_name"
            android:progressBackgroundTint="@color/base_green" />

        <TextView
            android:id="@+id/recycler_tool_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/divider"
            app:layout_constraintTop_toBottomOf="@id/recycler_seekbar"
            android:layout_weight="1"
            android:textStyle="bold"
            tool:text="300" />

        <View
            android:id="@+id/divider"
            android:layout_width="2dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/recycler_seekbar"
            app:layout_constraintStart_toEndOf="@id/recycler_tool_value"
            app:layout_constraintEnd_toStartOf="@id/recyclerEncoderValue"
            android:layout_margin="@dimen/margin_medium"
            android:background="@color/gray" />

        <TextView
            android:id="@+id/recyclerEncoderValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_medium"
            android:layout_weight="1"
            app:layout_constraintStart_toEndOf="@id/divider"
            app:layout_constraintEnd_toStartOf="@id/recycler_switch"
            app:layout_constraintTop_toBottomOf="@id/recycler_seekbar"
            android:textColor="@color/base_green"
            android:text="@{viewModel.encoderValue}"
            android:textStyle="bold"
            tool:text="300" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/recycler_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_medium"
            app:layout_constraintStart_toEndOf="@id/recyclerEncoderValue"
            app:layout_constraintTop_toBottomOf="@id/recycler_seekbar"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_weight="1" />



    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>