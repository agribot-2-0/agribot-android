<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_weight="1.7"
    android:background="@drawable/shape_background_transparent"
    android:orientation="horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android">


    <TextView
        android:id="@+id/selectedDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="50dp"
        android:layout_marginTop="12dp"
        android:text="Today"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/selectedTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="220dp"
        android:layout_marginTop="12dp"
        android:text="Now"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/selectedWeather"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="380dp"
        android:layout_marginTop="12dp"
        android:text="[No weather condition selected]"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="visible" />

    <ImageView
        android:id="@+id/visInWindIc"
        android:layout_width="@dimen/infoIconDim"
        android:layout_height="@dimen/infoIconDim"
        android:layout_marginStart="380dp"
        android:src="@drawable/ic_wind"
        android:visibility="invisible" />

    <ImageView
        android:id="@+id/visInTempIc"
        android:layout_width="@dimen/infoIconDim"
        android:layout_height="@dimen/infoIconDim"
        android:layout_marginStart="460dp"
        android:src="@drawable/ic_celsius"
        android:visibility="invisible" />

    <ImageView
        android:id="@+id/visInHumiIc"
        android:layout_width="@dimen/infoIconDim"
        android:layout_height="@dimen/infoIconDim"
        android:layout_marginStart="540dp"
        android:src="@drawable/ic_humidity"
        android:visibility="invisible" />

    <ImageView
        android:id="@+id/visInPressIc"
        android:layout_width="@dimen/infoIconDim"
        android:layout_height="@dimen/infoIconDim"
        android:layout_marginStart="620dp"
        android:src="@drawable/ic_pressure"
        android:visibility="invisible" />

    <Button
        android:id="@+id/progAndStart_btn"
        android:layout_width="220dp"
        android:layout_height="40dp"
        android:layout_marginStart="880dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/start_button_shape"
        android:shadowColor="#40A858"
        android:shadowRadius="5"
        android:text="Start now"
        android:textColor="#5E5E5E"
        android:textSize="20sp" />
</RelativeLayout>