<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="eu.agribot.agribotapp.ui.fragment.taskcreator.toolselect.CreatorToolSelectViewModel" />
    </data>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_gray"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/linearLayout3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="@dimen/margin_small"
            android:layout_weight="7"
            android:background="@color/background_gray">

            <TextView
                android:id="@+id/textView8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tool_name"
                app:layout_constraintBottom_toTopOf="@+id/front_tool_name"
                app:layout_constraintEnd_toEndOf="@+id/front_tool_name" />

            <Spinner
                android:id="@+id/front_tool_name"
                android:layout_width="@dimen/spinner_width"
                android:layout_height="@dimen/spinner_height"
                android:layout_marginEnd="@dimen/margin_large"
                android:layout_marginBottom="@dimen/margin_xxlarge"
                app:layout_constraintBottom_toTopOf="@+id/front_tool_mode"
                app:layout_constraintEnd_toStartOf="@+id/imageView3" />

            <TextView
                android:id="@+id/textView9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tool_mode"
                app:layout_constraintBottom_toTopOf="@+id/back_tool_mode"
                app:layout_constraintEnd_toEndOf="@+id/back_tool_mode" />

            <Spinner
                android:id="@+id/front_tool_mode"
                android:layout_width="@dimen/spinner_width"
                android:layout_height="@dimen/spinner_height"
                android:layout_marginEnd="@dimen/margin_large"
                app:layout_constraintBottom_toBottomOf="@+id/imageView3"
                app:layout_constraintEnd_toStartOf="@+id/imageView3" />

            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="733dp"
                android:layout_height="321dp"
                android:src="@drawable/agribot"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textView11"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tool_name"
                app:layout_constraintBottom_toTopOf="@+id/back_tool_name"
                app:layout_constraintEnd_toEndOf="@+id/back_tool_name" />

            <Spinner
                android:id="@+id/back_tool_name"
                android:layout_width="@dimen/spinner_width"
                android:layout_height="@dimen/spinner_height"
                android:layout_marginStart="@dimen/margin_large"
                android:layout_marginBottom="@dimen/margin_xxlarge"
                app:layout_constraintBottom_toTopOf="@+id/back_tool_mode"
                app:layout_constraintStart_toEndOf="@+id/imageView3" />

            <TextView
                android:id="@+id/textView12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tool_mode"
                app:layout_constraintBottom_toTopOf="@+id/front_tool_mode"
                app:layout_constraintEnd_toEndOf="@+id/front_tool_mode" />

            <Spinner
                android:id="@+id/back_tool_mode"
                android:layout_width="@dimen/spinner_width"
                android:layout_height="@dimen/spinner_height"
                android:layout_marginStart="@dimen/margin_large"
                app:layout_constraintBottom_toBottomOf="@+id/imageView3"
                app:layout_constraintStart_toEndOf="@+id/imageView3" />


        </androidx.constraintlayout.widget.ConstraintLayout>


        <eu.agribot.agribotapp.ui.ViewBottomItemDetails
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>


    </LinearLayout>


</layout>